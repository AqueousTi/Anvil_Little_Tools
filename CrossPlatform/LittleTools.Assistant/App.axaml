<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LittleTools.Assistant.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Button.mode">
      <Setter Property="Background" Value="#18FFFFFF" />
      <Setter Property="BorderBrush" Value="#25FFFFFF" />
    </Style>
    <Style Selector="Button.mode.active">
      <Setter Property="Background" Value="#7357D3FF" />
      <Setter Property="BorderBrush" Value="#A68AE2FF" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
  </Application.Styles>
</Application>
