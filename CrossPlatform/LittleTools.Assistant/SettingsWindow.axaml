<!-- Linux side deviation: the dialog is transient for the assistant window,
     which itself skips the taskbar. GNOME therefore treats this dialog as the
     app's only taskbar-worthy window and puts a Little Tools icon in the dock
     while the settings are open (verified on GNOME/mutter 46; the main window
     keeps _NET_WM_STATE_SKIP_TASKBAR). Skipping the taskbar here matches every
     other dialog in the suite (TodoDialogs, BacklogTabWindow,
     StockDetailsWindow, SelectionWindow) and removes the icon. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LittleTools.Assistant.SettingsWindow"
        Title="翻译与问答设置" Width="510" Height="730" CanResize="False"
        Background="#12161E" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid RowDefinitions="*,Auto" Margin="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="8">
      <TextBlock Text="API 配置" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="优先读取环境变量；Linux 用系统钥匙串，钥匙串不可用时保存到 XDG 配置目录的 credentials.json（重装不会丢），Windows 用当前用户 DPAPI。"
                 TextWrapping="Wrap" Foreground="#A8FFFFFF" />
      <TextBlock Text="环境变量：BAIDU_TRANSLATE_APP_ID / BAIDU_TRANSLATE_SECRET_KEY、ZHIPUAI_API_KEY、DEEPSEEK_API_KEY。"
                 TextWrapping="Wrap" Foreground="#8FD9FF" Margin="0,0,0,4" />

      <TextBlock Text="百度翻译 APPID（文本与图片共用）" Margin="0,6,0,0" />
      <TextBox x:Name="BaiduAppId" PlaceholderText="APPID" />
      <TextBlock Text="百度翻译密钥" />
      <TextBox x:Name="BaiduKey" PlaceholderText="密钥" PasswordChar="●" />
      <TextBlock x:Name="BaiduKeyHint" TextWrapping="Wrap" Foreground="#A8FFFFFF" />
      <TextBlock Text="兼容旧版翻译配置；图片翻译需在百度翻译开放平台单独开通。" TextWrapping="Wrap" Foreground="#A8FFFFFF" />

      <TextBlock Text="GLM 环境变量" />
      <TextBox x:Name="GlmEnvironment" PlaceholderText="ZHIPUAI_API_KEY" />
      <TextBlock Text="GLM API Key" />
      <TextBox x:Name="GlmKey" PlaceholderText="API Key" PasswordChar="●" />

      <TextBlock Text="DeepSeek 环境变量" Margin="0,8,0,0" />
      <TextBox x:Name="DeepSeekEnvironment" PlaceholderText="DEEPSEEK_API_KEY" />
      <TextBlock Text="DeepSeek API Key" />
      <TextBox x:Name="DeepSeekKey" PlaceholderText="API Key" PasswordChar="●" />

      <TextBlock x:Name="SettingsStatus" Foreground="#91D9FF" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="取消" />
      <Button x:Name="SaveButton" Content="保存" />
    </StackPanel>
  </Grid>
</Window>
