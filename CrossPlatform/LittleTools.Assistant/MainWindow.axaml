<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LittleTools.Assistant.MainWindow"
        Title="Little Tools AI"
        Width="520" Height="180" MinWidth="460" MinHeight="160"
        Background="Transparent"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False">
  <Border x:Name="WindowShell"
          Margin="8"
          Padding="14,11,14,10"
          CornerRadius="15"
          Background="#EE181B23"
          BorderBrush="#30FFFFFF"
          BorderThickness="1"
          BoxShadow="0 5 18 0 #50000000">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Button x:Name="TranslateMode" Content="翻译" Classes="mode active" />
          <Button x:Name="ChatMode" Content="快问" Classes="mode" />
          <Button x:Name="ScreenshotMode" Content="截图" Classes="mode" ToolTip.Tip="框选屏幕并翻译" />
          <Button x:Name="HistoryToggle" Content="☰" Classes="icon" Margin="14,0,0,0" ToolTip.Tip="历史记录" />
          <Button x:Name="OptionsToggle" Content="···" Classes="icon" ToolTip.Tip="模型与设置" />
          <Button x:Name="HideButton" Content="×" Classes="icon close" ToolTip.Tip="隐藏" />
        </StackPanel>
      </Border>

      <Border x:Name="AdvancedPanel" Grid.Row="1" IsVisible="False"
              Margin="0,0,0,8" Padding="8"
              CornerRadius="9" Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
          <ComboBox x:Name="ProviderSelector" Grid.Column="0" MinWidth="150" SelectedIndex="0">
            <ComboBoxItem Content="GLM 5.3 Flash" Tag="Glm" />
            <ComboBoxItem Content="DeepSeek V4.1 Flash" Tag="DeepSeek" />
          </ComboBox>
          <Button x:Name="ThinkingToggle" Grid.Column="1" Content="快速" ToolTip.Tip="切换回答深度" />
          <Button x:Name="SearchToggle" Grid.Column="2" Content="联网·自动" ToolTip.Tip="自动 / 开启 / 关闭" />
          <Button x:Name="SettingsButton" Grid.Column="3" Content="设置" />
        </Grid>
      </Border>

      <Grid x:Name="ConversationArea" Grid.Row="2" IsVisible="False" Height="350"
            ColumnDefinitions="Auto,*" Margin="0,0,0,8">
        <Border x:Name="HistoryPanel" Grid.Column="0" Width="205" IsVisible="False"
                Margin="0,0,10,0" Padding="9"
                Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
              <TextBlock Text="历史记录" FontSize="11" FontWeight="SemiBold" Foreground="#BFFFFFFF"
                         VerticalAlignment="Center" />
              <Button x:Name="NewConversationButton" Grid.Column="1" Content="＋" Classes="icon"
                      ToolTip.Tip="新会话" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="HistoryItems" Spacing="4" />
            </ScrollViewer>
          </Grid>
        </Border>

        <ScrollViewer x:Name="MessageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Padding="4,4,6,4">
          <StackPanel x:Name="MessagesPanel" Spacing="9" MaxWidth="680" HorizontalAlignment="Stretch" />
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="3" Background="#10FFFFFF" BorderBrush="#28FFFFFF"
              BorderThickness="1" CornerRadius="11" Padding="6,2">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5">
          <TextBox x:Name="Composer" Grid.Column="0" MinHeight="30" MaxHeight="90"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   PlaceholderText="输入文字，Enter 翻译…"
                   Background="Transparent" BorderThickness="0" Padding="2,3" />
          <Button x:Name="CaptureButton" Grid.Column="1" Content="▣" Classes="icon"
                  VerticalAlignment="Center" ToolTip.Tip="截图翻译" />
          <Button x:Name="StopButton" Grid.Column="2" Content="停止" IsVisible="False"
                  VerticalAlignment="Center" />
          <Button x:Name="SendButton" Grid.Column="3" Content="→" Classes="send"
                  VerticalAlignment="Center" ToolTip.Tip="发送" />
        </Grid>
      </Border>

      <TextBlock x:Name="StatusText" Grid.Row="4" Margin="3,4,3,0"
                 FontSize="9.5" Foreground="#72FFFFFF"
                 Text="GLM 5.3 Flash · 快速" />
    </Grid>
  </Border>
</Window>
