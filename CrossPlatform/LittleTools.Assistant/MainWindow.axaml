<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LittleTools.Assistant.MainWindow"
        Title="Little Tools AI"
        Width="900" Height="620" MinWidth="720" MinHeight="480"
        Background="#10131A"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="52,*,Auto">
    <Border Grid.Row="0" Background="#171B24" BorderBrush="#24FFFFFF" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="7">
        <Button x:Name="HistoryToggle" Grid.Column="0" Content="☰" Width="38" ToolTip.Tip="历史记录" />
        <Button x:Name="TranslateMode" Grid.Column="1" Content="翻译" Classes="mode" />
        <Button x:Name="ChatMode" Grid.Column="2" Content="快问" Classes="mode active" />
        <Button x:Name="ScreenshotMode" Grid.Column="3" Content="截图翻译" Classes="mode" />
        <ComboBox x:Name="ProviderSelector" Grid.Column="5" Width="158" SelectedIndex="0">
          <ComboBoxItem Content="GLM 5.3 Flash" Tag="Glm" />
          <ComboBoxItem Content="DeepSeek V4.1 Flash" Tag="DeepSeek" />
        </ComboBox>
        <Button x:Name="ThinkingToggle" Grid.Column="6" Content="快速" ToolTip.Tip="切换回答深度" />
        <Button x:Name="SearchToggle" Grid.Column="7" Content="联网·自动" ToolTip.Tip="自动 / 开启 / 关闭" />
        <Button x:Name="SettingsButton" Grid.Column="8" Content="设置" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <Border x:Name="HistoryPanel" Grid.Column="0" Width="230" IsVisible="False"
              Background="#151923" BorderBrush="#24FFFFFF" BorderThickness="0,0,1,0" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,10">
            <TextBlock Text="历史记录" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="NewConversationButton" Grid.Column="1" Content="＋" Width="34" ToolTip.Tip="新会话" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="HistoryItems" Spacing="5" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto">
        <ScrollViewer x:Name="MessageScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,18">
          <StackPanel x:Name="MessagesPanel" Spacing="12" MaxWidth="760" HorizontalAlignment="Stretch" />
        </ScrollViewer>

        <Border Grid.Row="1" Margin="16,8,16,14" Background="#1A1F2A" BorderBrush="#30FFFFFF"
                BorderThickness="1" CornerRadius="13" Padding="10">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
            <TextBox x:Name="Composer" Grid.Column="0" Grid.Row="0" MinHeight="44" MaxHeight="150"
                     AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="输入问题，Enter 发送，Shift+Enter 换行…"
                     Background="Transparent" BorderThickness="0" />
            <Button x:Name="CaptureButton" Grid.Column="1" Grid.Row="0" Content="截图" VerticalAlignment="Bottom" />
            <Button x:Name="StopButton" Grid.Column="2" Grid.Row="0" Content="停止" IsVisible="False" VerticalAlignment="Bottom" />
            <Button x:Name="SendButton" Grid.Column="3" Grid.Row="0" Content="发送" VerticalAlignment="Bottom" />
            <TextBlock x:Name="StatusText" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1"
                       Margin="4,6,4,0" FontSize="11" Foreground="#88FFFFFF"
                       Text="Shift + Backspace 唤醒 · 截图不会保存到历史" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Height="1" Background="#18FFFFFF" />
  </Grid>
</Window>
