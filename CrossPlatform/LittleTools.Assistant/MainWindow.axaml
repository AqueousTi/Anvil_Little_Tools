<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LittleTools.Assistant.MainWindow"
        Title="Little Tools AI"
        Width="430" Height="140" MinWidth="1" MinHeight="1"
        Background="Transparent"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        TransparencyBackgroundFallback="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False">
  <ExperimentalAcrylicBorder CornerRadius="16" ClipToBounds="True">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial
            BackgroundSource="Digger"
            TintColor="#11141B"
            TintOpacity="0.04"
            MaterialOpacity="0.04"
            PlatformTransparencyCompensationLevel="0"
            FallbackColor="#4811141B" />
      </ExperimentalAcrylicBorder.Material>

    <Border x:Name="WindowShell"
          Margin="1"
          Padding="16,13"
          CornerRadius="15"
          Background="#4811141B"
          BorderBrush="#30FFFFFF"
          BorderThickness="1">
    <Grid x:Name="AssistantLayout" RowDefinitions="Auto,Auto,*,Auto,Auto">
      <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent" Margin="0,0,0,8">
        <DockPanel LastChildFill="True">
          <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3">
            <Button x:Name="HistoryToggle" Theme="{StaticResource WidgetButtonTheme}" Width="40" MinWidth="40" FontSize="9.5" Foreground="#96DCE0E8" Content="历史" Classes="icon" ToolTip.Tip="历史记录" />
            <Button x:Name="OptionsToggle" Theme="{StaticResource WidgetButtonTheme}" Width="40" MinWidth="40" FontSize="9.5" Foreground="#96DCE0E8" Content="设置" Classes="icon" ToolTip.Tip="模型与设置" />
            <Button x:Name="HideButton" Theme="{StaticResource WidgetButtonTheme}" Width="40" MinWidth="40" FontSize="9.5" Foreground="#88FFFFFF" Content="隐藏" Classes="icon close" ToolTip.Tip="隐藏" />
          </StackPanel>
          <TextBlock x:Name="ComponentTitle" IsVisible="False" Margin="5,0,0,0"
                     VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#B8FFFFFF" />
          <StackPanel x:Name="ModeActions" Orientation="Horizontal" Spacing="3">
            <Button x:Name="TranslateMode" Theme="{StaticResource WidgetButtonTheme}" Width="45" MinWidth="0" FontSize="10.5" Content="翻译" Classes="mode active" />
            <Button x:Name="ChatMode" Theme="{StaticResource WidgetButtonTheme}" Width="45" MinWidth="0" FontSize="10.5" Content="快问" Classes="mode" />
            <Button x:Name="ScreenshotMode" Theme="{StaticResource WidgetButtonTheme}" Width="45" MinWidth="0" FontSize="10.5" Content="截图" Classes="mode" ToolTip.Tip="框选屏幕并翻译" />
            <Button x:Name="TranslationRouteButton" Theme="{StaticResource WidgetButtonTheme}" Width="104" MinWidth="104"
                    FontSize="9.5" Content="中英互译 ▾" Classes="mode" ToolTip.Tip="选择翻译语言" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border x:Name="AdvancedPanel" Grid.Row="1" IsVisible="False"
              Margin="0,0,0,8" Padding="8"
              CornerRadius="9" Background="#18191B21" BorderBrush="#24FFFFFF" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
          <ComboBox x:Name="ProviderSelector" Grid.Column="0" MinWidth="150" SelectedIndex="0">
            <ComboBoxItem Content="GLM 5.3 Flash" Tag="Glm" />
            <ComboBoxItem Content="DeepSeek V4.1 Flash" Tag="DeepSeek" />
          </ComboBox>
          <Button x:Name="ThinkingToggle" Theme="{StaticResource WidgetButtonTheme}" Grid.Column="1" Content="快速" ToolTip.Tip="切换回答深度" />
          <Button x:Name="SearchToggle" Theme="{StaticResource WidgetButtonTheme}" Grid.Column="2" Content="联网·自动" ToolTip.Tip="自动 / 开启 / 关闭" />
          <Button x:Name="SettingsButton" Theme="{StaticResource WidgetButtonTheme}" Grid.Column="3" Content="设置" />
        </Grid>
      </Border>

      <Grid x:Name="ConversationArea" Grid.Row="2" IsVisible="False"
            ColumnDefinitions="Auto,*" Margin="0,0,0,8">
        <Border x:Name="HistoryPanel" Grid.Column="0" Width="205" IsVisible="False"
                Margin="0,0,10,0" Padding="9"
                Background="#18191B21" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="10">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
              <TextBlock Text="历史记录" FontSize="11" FontWeight="SemiBold" Foreground="#BFFFFFFF"
                         VerticalAlignment="Center" />
              <Button x:Name="NewConversationButton" Theme="{StaticResource WidgetButtonTheme}" Grid.Column="1" Content="＋" Classes="icon"
                      ToolTip.Tip="新会话" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="HistoryItems" Spacing="4" />
            </ScrollViewer>
          </Grid>
        </Border>

        <ScrollViewer x:Name="MessageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Padding="4,4,6,4">
          <StackPanel x:Name="MessagesPanel" Spacing="9" MaxWidth="680" HorizontalAlignment="Stretch" />
        </ScrollViewer>
      </Grid>

      <Border x:Name="ComposerBar" Grid.Row="3" Background="Transparent" BorderBrush="Transparent"
              BorderThickness="0" CornerRadius="8" Padding="0">
        <Grid x:Name="ComposerGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="6">
          <TextBox x:Name="Composer" Grid.Column="0" MinHeight="45" MinWidth="0" MaxHeight="90" Classes="glassInput"
                   Theme="{StaticResource GlassTextBoxTheme}"
                   AcceptsReturn="False" TextWrapping="Wrap"
                   Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="4,3" FontSize="14">
          </TextBox>
          <TextBlock x:Name="ComposerPlaceholder" Grid.Column="0"
                     Text="输入文字，Enter 翻译 · Alt+Enter 换行" FontSize="14" Foreground="#69FFFFFF"
                     Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          <StackPanel x:Name="TranslationToolbar" Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
            <Button x:Name="CompactTranslationRouteButton" Theme="{StaticResource WidgetButtonTheme}"
                    MinWidth="80" MaxWidth="210" Height="21" MinHeight="21" Padding="4,1" FontSize="9.5"
                    Content="中英互译 ▾" Classes="mode" ToolTip.Tip="选择翻译语言；菜单底部可设置百度账号" />
            <Button x:Name="CaptureButton" Theme="{StaticResource WidgetButtonTheme}" Content="截图" Classes="mode"
                    MinWidth="36" Height="21" MinHeight="21" Padding="4,1" FontSize="9.5" ToolTip.Tip="框选屏幕并翻译成中文" />
          </StackPanel>
          <Button x:Name="StopButton" Theme="{StaticResource WidgetButtonTheme}" Grid.Column="1" Grid.RowSpan="2" Content="停止" IsVisible="False"
                  VerticalAlignment="Center" />
          <Button x:Name="SendButton" Theme="{StaticResource WidgetButtonTheme}" Grid.Column="1" Grid.RowSpan="2"
                  Width="32" Height="30" Padding="0" Foreground="#A8FFD2" Classes="send"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="发送">
            <Path Data="M 0,5 L 12,5 M 7,0 L 12,5 L 7,10" Width="14" Height="12"
                  Stretch="Uniform" Stroke="#A8FFD2" StrokeThickness="1.6" />
          </Button>
        </Grid>
      </Border>

      <TextBlock x:Name="StatusText" Grid.Row="4" IsVisible="False" Margin="3,4,3,0"
                 FontSize="9.5" Foreground="#72FFFFFF"
                 Text="GLM 5.3 Flash · 快速" />
    </Grid>
    </Border>
  </ExperimentalAcrylicBorder>
</Window>
